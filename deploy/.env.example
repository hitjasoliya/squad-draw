# PostgreSQL Connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/squad_draw
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=squad_draw

# Redis Connection
REDIS_URL=redis://localhost:6379

# JWT Auth Secret (MUST be at least 32 random characters in production)
JWT_SECRET=super-secret-jwt-key-change-in-prod

# Auth Service Endpoint (consumed by web tier)
AUTH_SERVICE_URL=http://localhost:4000

# Web & WS URLs
ORIGIN_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_WEBSOCKET_URL=http://localhost:8080
NEXT_PUBLIC_MAX_CREATED_ROOMS=5
